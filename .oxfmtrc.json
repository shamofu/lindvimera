{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": false,
  "semi": true,
  "printWidth": 100,
  "ignorePatterns": [
    "codemirror-vim/**",
    ".generated/**",
    ".cache/**",
    ".test-vault/**",
    ".test-runtime/**",
    "node_modules/**",
    "coverage/**",
    "dist/**",
    ".release/**",
    ".release-gate/**",
    "test-results/**",
    "patches/**/*.patch",
    "test/fixtures/**"
  ]
}
