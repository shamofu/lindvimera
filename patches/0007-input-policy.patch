@@ -26,6 +26,34 @@ var FIREFOX_LINUX = typeof navigator != "undefined"
 
 const Vim = initVim(CodeMirror);
 
+export type VimKeyEventResult = 'handled' | 'native' | 'unhandled';
+const keyEventResults = new WeakMap<KeyboardEvent, Map<CodeMirror, VimKeyEventResult>>();
+
+/** Mark an event owned by a host UI before the later CodeMirror DOM handler. */
+export function skipVimKeyEvent(cm: CodeMirror, event: KeyboardEvent): void {
+  let results = keyEventResults.get(event);
+  if (!results) keyEventResults.set(event, results = new Map());
+  results.set(cm, 'native');
+}
+
+/** One physical event makes at most one Vim attempt, including unhandled keys. */
+export function dispatchVimKeyEvent(cm: CodeMirror, event: KeyboardEvent, view = cm.getEditingView()): VimKeyEventResult {
+  let results = keyEventResults.get(event);
+  if (!results) keyEventResults.set(event, results = new Map());
+  const previous = results.get(cm);
+  if (previous) return previous;
+  results.set(cm, 'unhandled');
+  const plugin = cm.state.vimPlugin;
+  if (!plugin || event.defaultPrevented || cm.getEditingView() !== view) return 'unhandled';
+  CodeMirror.signal(cm, 'inputEvent', event);
+  plugin.lastKeydown = event.key;
+  plugin.useNextTextInput = event.isComposing || ['Unidentified', 'Process', 'Dead'].includes(event.key);
+  const handled = !plugin.useNextTextInput && cm.operation(() => plugin.handleKey(event, view));
+  const result = handled ? 'handled' : cm.state.vim?.insertMode || plugin.useNextTextInput ? 'native' : 'unhandled';
+  results.set(cm, result);
+  return result;
+}
